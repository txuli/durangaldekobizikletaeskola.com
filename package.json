{
  "name": "durangonextjs",
  "version": "1.5.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4225 &&  ssh -N durango-db-tunnel",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pm2:start": "pm2 start \"npm run start\" --name durangobzk",
    "pm2:rs": "pm2 restart durangobzk --update-env",
    "pm2:stop": "pm2 delete durangobzk"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "1.0.1",
    "better-auth": "^1.6.25",
    "busboy": "^1.6.0",
    "discord-logify": "^0.2.2",
    "dotenv": "^16.6.1",
    "file-saver": "^2.0.5",
    "mysql2": "^3.23.1",
    "next": "^15.5.25",
    "next-intl": "^4.13.4",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-slideshow-image": "^4.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/estree": "^1.0.9",
    "@types/file-saver": "^2.0.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.23",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
